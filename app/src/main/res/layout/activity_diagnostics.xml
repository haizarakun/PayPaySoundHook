<?xml version="1.0" encoding="utf-8"?>
<!--
  診断画面。
  レポート本文が主役なので、操作は下に固定した一列にまとめている。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="24dp"
        android:paddingBottom="2dp"
        android:text="@string/diagnostics_title"
        android:textColor="@color/text_primary"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="14dp"
        android:text="音が変わらないときは、まず「動作条件」を上から確認してください。"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_card"
        android:padding="14dp"
        android:scrollbarStyle="outsideOverlay">

        <TextView
            android:id="@+id/diagnostics_report"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textIsSelectable="true"
            android:typeface="monospace"
            android:textSize="12sp"
            android:lineSpacingExtra="2dp" />

    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp">

        <Button
            android:id="@+id/diagnostics_copy"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button_primary"
            android:text="コピー"
            android:textColor="@color/accent_text"
            android:textSize="14sp"
            android:textAllCaps="false"
            android:stateListAnimator="@null" />

        <Button
            android:id="@+id/diagnostics_share"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_button_ghost"
            android:text="共有"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textAllCaps="false"
            android:stateListAnimator="@null" />

        <Button
            android:id="@+id/diagnostics_clear"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_button_ghost"
            android:text="ログ消去"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:textAllCaps="false"
            android:stateListAnimator="@null" />

    </LinearLayout>

    <Button
        android:id="@+id/diagnostics_check_update"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bg_button_ghost"
        android:text="更新を確認"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:textAllCaps="false"
        android:stateListAnimator="@null" />

</LinearLayout>
